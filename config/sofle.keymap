#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2

/ {
    macros {
        tmux: tmux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(A)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            bindings = <
&kp GRAVE       &kp N1   &kp N2    &kp N3    &kp N4    &kp N5                                &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS
&kp TAB         &kp Q    &kp W     &kp E     &kp R     &kp T                                 &kp Y     &kp U     &kp I     &kp O     &kp P     &kp EQUAL
&mt LCTRL ESC   &kp A    &kp S     &kp D     &kp F     &kp G                                 &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
&kp LSHFT       &kp Z    &kp X     &kp C     &kp V     &kp B      &kp C_MUTE    &kp C_PP     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                         &tmux     &kp LALT  &kp LGUI  &mo LOWER  &kp SPACE     &kp BSPC     &mo RAISE &kp RET   &kp RALT  &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "lower";
            bindings = <
&kp F1          &kp F2   &kp F3    &kp F4    &kp F5    &kp F6                                &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&kp GRAVE       &kp EXCL &kp AT    &kp HASH  &kp DLLR  &kp PRCNT                             &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &trans
&trans          &kp N1   &kp N2    &kp N3    &kp N4    &kp N5                                &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &trans
&trans          &trans   &trans    &kp LBKT  &kp LBRC  &trans     &trans        &trans       &trans    &kp RBRC  &kp RBKT  &kp BSLH  &trans    &trans
                         &trans    &trans    &trans    &trans     &trans        &trans       &trans    &trans    &trans    &trans
            >;
        };

        raise_layer {
            display-name = "raise";
            bindings = <
&bootloader     &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3       &bt BT_SEL 4                       &trans    &trans    &trans    &trans    &trans    &bootloader
&bt BT_CLR      &rgb_ug RGB_TOG    &rgb_ug RGB_EFF    &rgb_ug RGB_BRI    &rgb_ug RGB_BRD    &trans                             &kp HOME  &kp PG_DN &kp PG_UP &kp END   &trans    &trans
&trans          &kp LA(N1)         &kp LA(N2)         &kp LA(N3)         &kp LA(N4)         &kp LA(N5)                         &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp DEL   &trans
&trans          &kp LS(LA(N1))     &kp LS(LA(N2))     &kp LS(LA(N3))     &kp LS(LA(N4))     &kp LS(LA(N5))   &trans   &trans   &kp C_PREV &kp C_NEXT &trans  &trans    &trans    &trans
                                   &trans             &trans             &trans             &trans           &trans   &trans   &trans    &trans    &trans    &trans
            >;
        };
    };
};
